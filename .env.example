# CoinStack environment — copy to .env; the binary loads ./.env automatically
# (existing environment variables always win).

# --- CoinMarketCap ---
CMC_API_KEY=                          # required for the real API; leave empty for fakecmc
CMC_BASE_URL=https://pro-api.coinmarketcap.com  # set to http://localhost:8181 for local dev
COINSTACK_CMC_RPM=25                  # CMC request rate limit

# --- Poll schedule presets (COINSTACK_PRESET) ---
#   free:     TopN 1000, FastN 200, poll 10m / slow 30m  (~386 credits/day)
#   startup:  TopN 3000, FastN 200, poll 2m  / slow 15m  (~2.1k credits/day) [default]
#   standard: TopN 5000, FastN 500, poll 1m  / slow 10m  (~7.7k credits/day)
# Each individual knob below still wins when set.
COINSTACK_PRESET=startup
#COINSTACK_TOP_N=3000
#COINSTACK_FAST_N=200
#COINSTACK_PAGE_SIZE=1000
#COINSTACK_POLL_INTERVAL=2m
#COINSTACK_SLOW_INTERVAL=15m

# --- HTTP ---
PORT=8080
LOG_LEVEL=info                        # debug, info, warn, error

# --- Auth ---
# COINSTACK_AUTH=off makes every endpoint public — local development only.
# With auth on, keys come from the database (coinstack keys create) and/or
# the static list below: comma-separated "key[:owner[:rpm]]" entries.
COINSTACK_AUTH=on
#COINSTACK_API_KEYS=devkey12345:alice:120
COINSTACK_DEFAULT_RATE_LIMIT=60       # requests/min for keys without their own limit

# --- Freshness ---
COINSTACK_STALE_AFTER=180s            # data older than this gets a stale_data warning
COINSTACK_MAX_STALE=30m               # data older than this answers 503 with stale payload

# --- Database (optional; memory-only without it) ---
DATABASE_URL=                         # postgres://... enables persistence + DB keys
COINSTACK_SNAPSHOT_EVERY=5m

# --- On-demand upstream budget ---
COINSTACK_ONDEMAND_PER_MIN=5
COINSTACK_ONDEMAND_PER_DAY=1000

# --- Telegram bot (optional; disabled when the token is empty) ---
TELEGRAM_BOT_TOKEN=                   # token from @BotFather
TELEGRAM_CHAT_IDS=                    # comma list of chat ids allowed to run commands
TELEGRAM_DIGEST_HOUR=9                # UTC hour of the daily digest (0-23)
TELEGRAM_ALERTS=gems,climbers,listings,digest  # comma subset; default all
